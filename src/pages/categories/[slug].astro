---
// src/pages/categories/[slug].astro
import Layout from '../../layouts/Layout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { CATEGORIES } from '../../utils/categories';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categorySlugs = Object.keys(CATEGORIES);
  return categorySlugs.map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;
const category = CATEGORIES[slug];

if (!category) {
  throw new Error(`Category not found: ${slug}`);
}

const allWorks = await getCollection('works');
const categoryWorks = allWorks.filter(w => w.data.category === slug);
---
<Layout title={`${category.name} — Grace Interior Designs`} description={category.description}>
  
  <!-- ═══════════════════════════════════════════════
       HERO BANNER
  ═══════════════════════════════════════════════ -->
  <section class="relative bg-brand-primary text-white py-24 px-6 overflow-hidden">
    <!-- Subtle Background Texture -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle, #E8A020 1px, transparent 1px); background-size: 40px 40px;"></div>
    
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row gap-12 md:items-end justify-between">
      <div class="max-w-3xl">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-xs text-white/50 mb-8 gap-3 uppercase tracking-widest font-medium">
          <a href="/" class="hover:text-brand-accent transition">Home</a>
          <span class="w-1 h-1 rounded-full bg-white/20"></span>
          <a href="/categories" class="hover:text-brand-accent transition">Categories</a>
          <span class="w-1 h-1 rounded-full bg-brand-accent"></span>
          <span class="text-white">{category.name}</span>
        </nav>

        <h1 class="font-display text-5xl sm:text-7xl font-bold leading-none mb-6">{category.name}</h1>
        <p class="text-white/75 text-lg sm:text-xl font-light leading-relaxed max-w-2xl">
          {category.description}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-8 md:text-right" style="transition-delay: 0.1s">
        <div>
          <span class="block text-xs uppercase tracking-widest text-brand-accent font-semibold mb-2">Projects</span>
          <span class="block font-display text-4xl">{categoryWorks.length}</span>
        </div>
        <div class="hidden sm:block w-px bg-white/20"></div>
        <div>
          <span class="block text-xs uppercase tracking-widest text-brand-accent font-semibold mb-2">Starting Price</span>
          <span class="block font-display text-4xl">{category.startingPrice}</span>
        </div>
        <div class="hidden sm:block w-px bg-white/20"></div>
        <div>
          <span class="block text-xs uppercase tracking-widest text-brand-accent font-semibold mb-2">Timeline</span>
          <span class="block font-display text-4xl">{category.averageTime}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="py-16 px-4 sm:px-6 max-w-7xl mx-auto">
    <!-- ═══════════════════════════════════════════════
         MASONRY GRID
    ═══════════════════════════════════════════════ -->
    {categoryWorks.length > 0 ? (
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-10" id="worksGrid">
        {categoryWorks.map((w, index) => (
          <WorkCard workData={w} index={index} />
        ))}
      </div>
    ) : (
      <div class="text-center py-32 text-brand-text/50">
        <h3 class="font-display text-2xl text-brand-primary mb-2">No projects found.</h3>
        <p class="font-light">We are continually updating our portfolio.</p>
      </div>
    )}
  </div>

  <!-- ═══════════════════════════════════════════════
       PROJECT MODAL (Immersive Overlay)
  ═══════════════════════════════════════════════ -->
  <div id="projectModal" class="fixed inset-0 z-50 bg-brand-bg/95 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] flex overflow-hidden">
    <!-- Close Button -->
    <button id="closeModalBtn" class="absolute top-6 right-6 z-[60] w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white text-brand-primary border border-brand-divider/20 hover:border-transparent hover:shadow-lg transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="w-full h-full flex flex-col lg:flex-row relative">
      <!-- Left: Large Gallery (60%) -->
      <div class="w-full lg:w-3/5 h-[50vh] lg:h-full bg-[#E5E5E5] relative flex items-center justify-center">
        <!-- Main Image Stage -->
        <div class="absolute inset-0 flex snap-x snap-mandatory overflow-x-auto hide-scrollbar scroll-smooth" id="modalImageTrack">
          <!-- Images injected by JS -->
        </div>
        
        <!-- Gallery Controls -->
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-4 bg-white/90 backdrop-blur-md px-6 py-3 rounded-full shadow-lg z-10">
          <button id="modalPrevBtn" class="text-brand-primary hover:text-brand-accent transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <span id="modalImageCounter" class="text-sm font-semibold tracking-widest uppercase">1 / 1</span>
          <button id="modalNextBtn" class="text-brand-primary hover:text-brand-accent transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Right: Info Panel (40%) -->
      <div class="w-full lg:w-2/5 h-[50vh] lg:h-full overflow-y-auto bg-white border-l border-brand-divider px-6 sm:px-12 py-12 lg:py-24">
        <div class="max-w-md mx-auto relative h-full flex flex-col">
          <span id="modalCategory" class="text-xs uppercase tracking-widest text-brand-accent font-semibold mb-3 block">Category</span>
          <h2 id="modalTitle" class="font-display text-4xl font-bold text-brand-primary mb-6">Project Title</h2>
          <p id="modalLocation" class="text-sm text-brand-text/60 italic mb-8 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span id="modalLocationText">Location</span>
          </p>

          <p id="modalDescription" class="text-brand-text/80 text-base leading-relaxed mb-10 font-light"></p>

          <!-- Spec Grid -->
          <div class="grid grid-cols-2 gap-x-8 gap-y-6 mb-12 border-y border-brand-divider/40 py-8">
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-brand-text/50 font-bold mb-1">Wall Size</span>
              <span id="modalWallSize" class="text-brand-primary font-medium">N/A</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-brand-text/50 font-bold mb-1">Surface</span>
              <span id="modalSurface" class="text-brand-primary font-medium">N/A</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-brand-text/50 font-bold mb-1">Price Range</span>
              <span id="modalPrice" class="text-brand-primary font-bold text-lg">N/A</span>
            </div>
            <div>
              <span class="block text-[10px] uppercase tracking-widest text-brand-text/50 font-bold mb-1">Timeline</span>
              <span id="modalTime" class="text-brand-primary font-bold text-lg">N/A</span>
            </div>
          </div>

          <div class="mb-12">
            <span class="block text-[10px] uppercase tracking-widest text-brand-text/50 font-bold mb-3">Materials Used</span>
            <ul id="modalMaterials" class="flex flex-wrap gap-2">
              <!-- Material pills injected via JS -->
            </ul>
          </div>

          <!-- CTAs -->
          <div class="mt-auto space-y-4">
            <a id="modalWaBtn" href="#" target="_blank" class="w-full bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold py-4 px-6 text-center flex items-center justify-center gap-3 transition duration-300">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.487 1.334 5.006l-1.416 5.176 5.297-1.389c1.472.802 3.136 1.226 4.773 1.227h.004c5.505 0 9.988-4.478 9.989-9.985 0-2.668-1.037-5.176-2.925-7.065-1.888-1.888-4.397-2.927-7.066-2.927zm5.228 14.108c-.216.606-1.258 1.164-1.74 1.214-.482.05-1.107.234-3.649-.787-2.73-1.096-4.492-3.868-4.629-4.051-.137-.183-1.107-1.472-1.107-2.806 0-1.334.698-1.99.948-2.256.25-.266.549-.333.732-.333.183 0 .366.002.524.01.166.008.391-.063.612.467.225.541.766 1.87.833 2.008.067.138.113.3.023.482-.09.183-.135.298-.266.457-.132.158-.278.354-.397.476-.132.135-.27.283-.116.549.154.266.686 1.134 1.472 1.834 1.011.901 1.864 1.181 2.13 1.314.266.133.424.116.582-.066.158-.183.674-.787.857-1.054.183-.266.366-.222.616-.133.25.09 1.581.745 1.854.882.274.137.457.208.524.324.067.116.067.674-.149 1.28z"/></svg>
              Chat on WhatsApp
            </a>
            <a id="modalCallBtn" href="tel:+919999999999" class="w-full bg-brand-primary hover:bg-brand-primary/90 text-white font-bold py-4 px-6 text-center flex items-center justify-center gap-3 transition duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call Now
            </a>
            <p class="text-[10px] uppercase tracking-widest text-brand-text/40 text-center mt-3">
              Final pricing depends on wall dimensions & artwork complexity.
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Hide scrollbar for the image track -->
  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <!-- Client-Side Scripting -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const workCards = document.querySelectorAll('.work-card');

      // --- Modal Logic ---
      const modal = document.getElementById('projectModal');
      const closeBtn = document.getElementById('closeModalBtn');
      let currentImageIndex = 0;
      let currentImages = [];

      function openModal(data) {
        // Populate Data
        document.getElementById('modalCategory').textContent = data.category.replace(/-/g, ' ');
        document.getElementById('modalTitle').textContent = data.title;
        document.getElementById('modalDescription').textContent = data.description;
        
        const locWrap = document.getElementById('modalLocation');
        if (data.location) {
          locWrap.style.display = 'flex';
          document.getElementById('modalLocationText').textContent = data.location;
        } else {
          locWrap.style.display = 'none';
        }

        document.getElementById('modalWallSize').textContent = data.wallSize || 'Custom / Bespoke';
        document.getElementById('modalSurface').textContent = data.surface || 'Any indoor wall';
        document.getElementById('modalPrice').textContent = data.priceRange || 'On Request';
        document.getElementById('modalTime').textContent = data.timeRange || 'TBD';

        const matContainer = document.getElementById('modalMaterials');
        matContainer.innerHTML = '';
        if (data.materials && data.materials.length) {
          data.materials.forEach(mat => {
            const li = document.createElement('li');
            li.className = 'text-[11px] uppercase tracking-wider bg-brand-bg border border-brand-divider px-3 py-1 text-brand-text/70 font-semibold';
            li.textContent = mat;
            matContainer.appendChild(li);
          });
        }

        // Setup Images Track
        const track = document.getElementById('modalImageTrack');
        track.innerHTML = '';
        currentImages = data.images || [];
        currentImageIndex = 0;
        
        currentImages.forEach((src, idx) => {
          const slide = document.createElement('div');
          slide.className = 'w-full h-full flex-shrink-0 flex items-center justify-center snap-center p-4 lg:p-12';
          slide.innerHTML = `<img src="${src}" alt="Image ${idx + 1}" class="max-w-full max-h-full object-contain shadow-2xl" />`;
          track.appendChild(slide);
        });

        updateGalleryCounter();

        // Setup WhatsApp CTA
        const waMsg = encodeURIComponent(`Hi Grace Interior Designs, I'm interested in the project: ${data.title}. Please share more details.`);
        document.getElementById('modalWaBtn').href = `https://wa.me/919999999999?text=${waMsg}`;

        // Show Modal
        document.body.style.overflow = 'hidden';
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
      }

      function closeModal() {
        document.body.style.overflow = '';
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
      }

      // Add click listeners to cards
      workCards.forEach(card => {
        card.addEventListener('click', () => {
          const dataStr = card.getAttribute('data-work-json');
          if (dataStr) {
            openModal(JSON.parse(dataStr));
          }
        });
      });

      closeBtn.addEventListener('click', closeModal);
      
      // Close on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('opacity-100')) {
          closeModal();
        }
      });

      // Gallery Controls
      const track = document.getElementById('modalImageTrack');
      
      function updateGalleryCounter() {
        if (currentImages.length > 0) {
          document.getElementById('modalImageCounter').textContent = `${currentImageIndex + 1} / ${currentImages.length}`;
        }
      }

      document.getElementById('modalPrevBtn').addEventListener('click', () => {
        if (currentImageIndex > 0) {
          currentImageIndex--;
          track.children[currentImageIndex].scrollIntoView({ behavior: 'smooth' });
          updateGalleryCounter();
        }
      });

      document.getElementById('modalNextBtn').addEventListener('click', () => {
        if (currentImageIndex < currentImages.length - 1) {
          currentImageIndex++;
          track.children[currentImageIndex].scrollIntoView({ behavior: 'smooth' });
          updateGalleryCounter();
        }
      });
      
      // Handle manual scroll updating the counter
      track.addEventListener('scroll', () => {
        const slideWidth = track.clientWidth;
        const newIndex = Math.round(track.scrollLeft / slideWidth);
        if (newIndex !== currentImageIndex && newIndex >= 0 && newIndex < currentImages.length) {
          currentImageIndex = newIndex;
          updateGalleryCounter();
        }
      });
    });
  </script>
</Layout>
