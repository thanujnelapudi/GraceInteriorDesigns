<!-- src/layouts/BaseLayout.astro -->
---
import '../styles/global.css';
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grace Interior Designs</title>
    <meta name="description" content="Luxury interior wall art and painting studio based in Hanumakonda, Warangal, and Hyderabad, India." />
    <!-- Open Graph tags -->
    <meta property="og:title" content="Grace Interior Designs" />
    <meta property="og:description" content="Luxury interior wall art and painting studio based in Hanumakonda, Warangal, and Hyderabad, India." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://graceinteriordesigns.vercel.app" />
    <meta property="og:image" content="/og-image.jpg" />
    <!-- GSAP via CDN -->
    <script type="module">
      import { gsap } from "https://cdn.jsdelivr.net/npm/gsap@3.12.5/+esm";
      import { ScrollTrigger } from "https://cdn.jsdelivr.net/npm/gsap@3.12.5/ScrollTrigger/+esm";
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.registerPlugin(ScrollTrigger);
      }
    </script>
  </head>
  <body class="font-body bg-brand-bg text-brand-text">
    <slot />
    <!-- Floating WhatsApp button -->
    <WhatsAppButton />
  </body>
</html>
