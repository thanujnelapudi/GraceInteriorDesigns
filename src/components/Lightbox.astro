---
// src/components/Lightbox.astro
---
<div id="mobileLightbox" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex-col justify-end md:hidden">
  <div class="relative w-full h-full flex flex-col justify-between">
    <!-- Top Close Bar -->
    <div class="p-4 flex justify-end relative z-10">
      <button id="closeLightbox" class="p-2 text-white bg-black/50 rounded-full hover:bg-black/80 focus:outline-none" aria-label="Close Lightbox">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Image Container (Top 55%) -->
    <div class="relative h-[55%] w-full flex items-center justify-center p-2">
      <img id="lightboxImg" src="" alt="" class="max-h-full max-w-full object-contain rounded-lg shadow-2xl" />
      <button id="prevWorkBtn" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full" aria-label="Previous Work">
        &larr;
      </button>
      <button id="nextWorkBtn" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full" aria-label="Next Work">
        &rarr;
      </button>
    </div>

    <!-- Content Panel (Bottom) -->
    <div class="bg-brand-bg rounded-t-2xl p-6 shadow-inner flex flex-col justify-between flex-1 overflow-y-auto">
      <div>
        <div class="flex items-center justify-between">
          <span id="lightboxCategory" class="category-label text-brand-accent font-semibold"></span>
          <span id="lightboxPrice" class="text-sm font-semibold text-brand-primary"></span>
        </div>
        <h3 id="lightboxTitle" class="font-display text-2xl text-brand-primary font-bold mt-1"></h3>
        <p id="lightboxTime" class="text-xs text-brand-text/70 mt-1"></p>
        <p id="lightboxDescription" class="text-sm text-brand-text mt-3 line-clamp-3"></p>
      </div>

      <div class="mt-4 pt-3 border-t border-brand-divider">
        <a
          id="lightboxWhatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full bg-[#25D366] hover:bg-[#20ba5a] text-white font-semibold py-3 px-4 rounded-lg flex items-center justify-center gap-2 text-center transition"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.487 1.334 5.006l-1.416 5.176 5.297-1.389c1.472.802 3.136 1.226 4.773 1.227h.004c5.505 0 9.988-4.478 9.989-9.985 0-2.668-1.037-5.176-2.925-7.065-1.888-1.888-4.397-2.927-7.066-2.927zm5.228 14.108c-.216.606-1.258 1.164-1.74 1.214-.482.05-1.107.234-3.649-.787-2.73-1.096-4.492-3.868-4.629-4.051-.137-.183-1.107-1.472-1.107-2.806 0-1.334.698-1.99.948-2.256.25-.266.549-.333.732-.333.183 0 .366.002.524.01.166.008.391-.063.612.467.225.541.766 1.87.833 2.008.067.138.113.3.023.482-.09.183-.135.298-.266.457-.132.158-.278.354-.397.476-.132.135-.27.283-.116.549.154.266.686 1.134 1.472 1.834 1.011.901 1.864 1.181 2.13 1.314.266.133.424.116.582-.066.158-.183.674-.787.857-1.054.183-.266.366-.222.616-.133.25.09 1.581.745 1.854.882.274.137.457.208.524.324.067.116.067.674-.149 1.28z"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  let currentWorks: HTMLElement[] = [];
  let currentIndex = 0;

  const lightbox = document.getElementById('mobileLightbox');
  const closeBtn = document.getElementById('closeLightbox');
  const imgEl = document.getElementById('lightboxImg') as HTMLImageElement;
  const titleEl = document.getElementById('lightboxTitle');
  const categoryEl = document.getElementById('lightboxCategory');
  const priceEl = document.getElementById('lightboxPrice');
  const timeEl = document.getElementById('lightboxTime');
  const descEl = document.getElementById('lightboxDescription');
  const waBtn = document.getElementById('lightboxWhatsapp') as HTMLAnchorElement;

  const prevBtn = document.getElementById('prevWorkBtn');
  const nextBtn = document.getElementById('nextWorkBtn');

  function updateLightbox(index: number) {
    if (!currentWorks[index]) return;
    const card = currentWorks[index];
    const title = card.dataset.workTitle || '';
    const category = card.dataset.workCategory || '';
    const categorySlug = card.dataset.workCategorySlug || '';
    const price = card.dataset.workPrice || '';
    const time = card.dataset.workTime || '';
    const image = card.dataset.workImage || '';
    const desc = card.dataset.workDescription || '';

    if (imgEl) imgEl.src = image;
    if (titleEl) titleEl.textContent = title;
    if (categoryEl) categoryEl.textContent = category;
    if (priceEl) priceEl.textContent = price;
    if (timeEl) timeEl.textContent = `Estimated time: ${time}`;
    if (descEl) descEl.textContent = desc;

    const msg = encodeURIComponent(`Hi Grace Interior Designs, I'm interested in your work: ${title} (${category}). Please contact me.`);
    if (waBtn) waBtn.href = `https://wa.me/919701483107?text=${msg}`;
  }

  function openLightbox(cards: HTMLElement[], startIndex: number) {
    if (window.innerWidth >= 768) return; // Only on mobile
    currentWorks = cards;
    currentIndex = startIndex;
    updateLightbox(currentIndex);
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
  }

  closeBtn?.addEventListener('click', () => {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
  });

  prevBtn?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      updateLightbox(currentIndex);
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentIndex < currentWorks.length - 1) {
      currentIndex++;
      updateLightbox(currentIndex);
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const allCards = Array.from(document.querySelectorAll('.work-card')) as HTMLElement[];
    allCards.forEach((card, i) => {
      card.addEventListener('click', (e) => {
        if (window.innerWidth < 768) {
          e.preventDefault();
          openLightbox(allCards, i);
        }
      });
    });
  });
</script>
