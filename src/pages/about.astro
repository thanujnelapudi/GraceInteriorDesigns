---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About Us — Grace Interior Designs"
  description="Discover the story behind Grace Interior Designs. A premium fine art and wall mural studio transforming luxury spaces in Hanumakonda, Warangal, and Hyderabad."
>
  <!-- ═══════════════════════════════════════════════
       1. HERO SECTION
  ═══════════════════════════════════════════════ -->
  <section
    class="relative h-[72vh] min-h-[520px] flex flex-col justify-center items-center text-center overflow-hidden"
  >
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1920&q=85"
        alt="Grace Interior Designs Studio"
        class="ken-burns w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Gradient overlay for readable text and visible imagery -->
      <div
        class="hero-gradient absolute inset-0"
      ></div>
    </div>

    <div
      class="relative z-10 max-w-5xl mx-auto px-6 flex flex-col items-center"
    >
      <span
        class="eyebrow text-brand-accent mb-6 block uppercase tracking-widest text-xs font-semibold"
        >Our Studio</span
      >
      <h1
        class="font-display text-white text-5xl sm:text-7xl lg:text-8xl font-bold leading-tight mb-8"
      >
        Creating Spaces That<br />
        <span class="italic text-brand-accent font-light">Tell Stories.</span>
      </h1>
      <p
        class="text-white/75 text-lg sm:text-xl font-light max-w-3xl mx-auto leading-relaxed"
      >
        Grace Interior Designs transforms ordinary walls into handcrafted
        artistic experiences across homes, villas, cafés, offices, restaurants,
        and commercial spaces.
      </p>

      <!-- Scroll indicator -->
      <div
        class="mt-12 flex flex-col items-center justify-center gap-2 text-white/50"
      >
        <span class="text-[10px] uppercase tracking-widest"
          >Scroll to explore</span
        >
        <div
          class="w-px h-16 bg-gradient-to-b from-brand-accent to-transparent animate-pulse"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       2. OUR STORY (Split Layout)
  ═══════════════════════════════════════════════ -->
  <section
    class="py-24 sm:py-32 px-4 sm:px-6 bg-brand-bg border-b border-brand-divider/30"
  >
    <div
      class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center"
    >
      <!-- Left: Premium Image -->
      <div class="relative group">
        <div
          class="absolute -inset-4 bg-brand-primary/5 transform -skew-y-2 group-hover:skew-y-0 transition-transform duration-700"
        >
        </div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-sm shadow-2xl border border-brand-accent/20">
          <img
            src="/HERO_IMG.png"
            alt="Samuel — Proprietor & Principal Interior Designer at Grace Interior Designs"
            class="w-full h-full object-cover object-[80%_center] transition-transform duration-1000 group-hover:scale-105"
            loading="lazy"
          />
          <!-- Luxury gradient backdrop for lower overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0b132b]/95 via-[#1a2a6c]/50 to-transparent"></div>

          <!-- Decorative gold vertical line -->
          <div
            class="absolute left-0 top-10 bottom-10 w-0.5 bg-brand-accent/70"
          >
          </div>

          <!-- Editorial Proprietor Card (Seamless & Luxurious) -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <!-- Studio Name -->
            <div class="flex items-center gap-2 mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
              <span class="font-bodoni italic text-brand-accent text-sm tracking-wider">Grace Interior Designs</span>
            </div>
            
            <!-- Proprietor Name -->
            <h3 class="font-bodoni text-3xl sm:text-4xl text-white font-medium tracking-tight mb-1">
              Samuel
            </h3>
            
            <!-- Title & Role -->
            <p class="text-[11px] sm:text-xs uppercase tracking-[0.22em] text-white/80 font-medium">
              Proprietor &amp; Lead Interior Designer
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Story -->
      <div class="space-y-8">
        <span class="eyebrow text-brand-accent block">The Beginning</span>
        <h2
          class="font-display text-4xl sm:text-5xl font-bold text-brand-primary leading-tight"
        >
          Born from a passion for <span class="italic font-light"
            >art, spaces, and stories.</span
          >
        </h2>

        <div
          class="space-y-6 text-brand-text/80 text-lg font-light leading-relaxed"
        >
          <p>
            Grace Interior Designs was born from a passion for turning spaces
            into expressions of creativity, character, and emotion. What began
            with a love for art and handcrafted expression has grown into a
            design practice where interiors and artwork come together as one.
          </p>
          <p>
            We believe a beautiful space should feel personal not simply
            decorated. From hand painted murals and expressive artwork to
            thoughtfully designed interiors, every element is created with
            purpose, bringing warmth, individuality, and a sense of story to the
            spaces we shape.
          </p>
          <p>
            Our approach is deeply personal and rooted in craftsmanship. We take
            inspiration from the people, architecture, culture, and character of
            each space, creating designs that cannot simply be copied or
            replicated. Every project is an opportunity to create something
            truly yours—a space that feels authentic, meaningful, and made to
            last.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       3. STUDIO HIGHLIGHTS (Animated Stats)
  ═══════════════════════════════════════════════ -->
  <section class="py-24 relative overflow-hidden bg-brand-primary text-white">
    <!-- Subtle Background Texture -->
    <div
      class="absolute inset-0 opacity-10 pointer-events-none"
      style="background-image: radial-gradient(circle, #E8A020 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-10 text-center divide-x divide-brand-accent/20"
      >
        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            10<span class="text-3xl">+</span>
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Years<br />Experience
          </div>
        </div>

        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            2,000<span class="text-3xl">+</span>
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Projects<br />Completed
          </div>
        </div>

        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            6
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Art<br />Categories
          </div>
        </div>

        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            100<span class="text-3xl">%</span>
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Custom<br />Designs
          </div>
        </div>

        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            <span class="text-brand-accent/50 text-4xl">★</span>
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Premium<br />Materials
          </div>
        </div>

        <div class="px-2">
          <div
            class="font-display text-5xl sm:text-6xl font-bold text-brand-accent mb-2"
          >
            5.0
          </div>
          <div
            class="text-xs uppercase tracking-widest font-semibold text-white/70"
          >
            Client<br />Satisfaction
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       4. OUR PHILOSOPHY
  ═══════════════════════════════════════════════ -->
  <section class="py-24 sm:py-32 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto text-center mb-20">
      <span class="eyebrow text-brand-accent mb-4 block">Core Beliefs</span>
      <h2
        class="font-display text-4xl sm:text-5xl font-bold text-brand-primary"
      >
        Our Philosophy
      </h2>
    </div>

    <div
      class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-20"
    >
      <!-- Philosophy 1 -->
      <div class="flex flex-col items-center text-center group pt-8 border-t border-brand-primary/10">
        <h3 class="font-display text-3xl font-bold text-brand-primary mb-3">
          Every wall deserves a story.
        </h3>
        <div
          class="w-8 h-px bg-brand-accent mb-4 transition-all duration-300 group-hover:w-16"
        >
        </div>
      </div>

      <!-- Philosophy 2 -->
      <div class="flex flex-col items-center text-center group pt-8 border-t border-brand-primary/10">
        <h3 class="font-display text-3xl font-bold text-brand-primary mb-3">
          Every design is handcrafted.
        </h3>
        <div
          class="w-8 h-px bg-brand-accent mb-4 transition-all duration-300 group-hover:w-16"
        >
        </div>
      </div>

      <!-- Philosophy 3 -->
      <div class="flex flex-col items-center text-center group pt-8 border-t border-brand-primary/10">
        <h3 class="font-display text-3xl font-bold text-brand-primary mb-3">
          Every project is unique.
        </h3>
        <div
          class="w-8 h-px bg-brand-accent mb-4 transition-all duration-300 group-hover:w-16"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       5. HOW WE WORK (Step-by-step Flow)
  ═══════════════════════════════════════════════ -->
  <section
    class="py-24 sm:py-32 px-4 sm:px-6 bg-brand-bg border-t border-brand-divider/30"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
          <span class="eyebrow text-brand-accent mb-3 block">Simple Process</span>
          <h2 class="font-display text-4xl sm:text-5xl font-bold text-brand-primary">
          How We Work
        </h2>
          <div class="w-12 h-0.5 bg-brand-accent mx-auto mt-5"></div>
      </div>

        <div class="relative flex flex-col lg:flex-row items-start justify-between">
          <div class="hidden lg:block absolute top-6 left-0 right-0 h-px bg-brand-divider/50 z-0"></div>

        {
          [
            { num: "01", title: "Consult", desc: "Understanding your space, lighting, and vision." },
            { num: "02", title: "Concept Design", desc: "Presenting sketches and color palettes for approval." },
            { num: "03", title: "Artwork Creation", desc: "Our master artists begin the handcrafted process." },
            { num: "04", title: "Installation", desc: "Professional, clean, and seamless on-site execution." },
            { num: "05", title: "Final Reveal", desc: "Handover of your newly transformed luxury space." },
          ].map((item, i) => (
              <div class="relative z-10 flex flex-col items-center text-center group w-full lg:w-1/5 mb-10 lg:mb-0 px-4">
                <div class="w-12 h-12 rounded-full bg-brand-bg border border-brand-accent flex items-center justify-center font-display text-brand-primary font-bold text-lg mb-6">
                  {item.num}
              </div>
                <h3 class="font-display text-xl font-bold text-brand-primary mb-2">{item.title}</h3>
                <p class="text-sm text-brand-text/70 font-light max-w-[200px] mx-auto">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       6. WHY CLIENTS CHOOSE GRACE (Premium Feature Cards)
  ═══════════════════════════════════════════════ -->
  <section
    class="py-24 sm:py-32 px-4 sm:px-6 bg-white border-t border-brand-divider/20"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="eyebrow text-brand-accent mb-4 block"
          >The Grace Difference</span
        >
        <h2
          class="font-display text-4xl sm:text-5xl font-bold text-brand-primary"
        >
          Why Clients Choose Us
        </h2>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12"
      >
        {
          [
            {
              title: "Handcrafted Artwork",
              desc: "No stencils or mass-produced prints. Every piece is 100% hand-painted by master artists.",
            },
            {
              title: "Luxury Finishes",
              desc: "We utilize premium textures, real gold leaf detailing, and specialized rendering techniques.",
            },
            {
              title: "Long-Lasting Materials",
              desc: "Using non-toxic, fade-resistant acrylics and moisture-resistant sealants for durability.",
            },
            {
              title: "On-Time Delivery",
              desc: "Strict adherence to project timelines with minimal disruption to your home or business.",
            },
            {
              title: "Collaborative Design",
              desc: "We work closely with architects and interior designers to match exact aesthetic goals.",
            },
            {
              title: "Personalized Consultation",
              desc: "Tailored advice on wall sizes, lighting, and color theory specific to your environment.",
            },
          ].map((feature) => (
            <div class="group relative pt-8 border-t border-brand-primary/10 hover:border-brand-accent transition-colors duration-500">
              <h3 class="font-display text-2xl font-bold text-brand-primary mb-3 group-hover:text-brand-accent transition-colors duration-300">
                {feature.title}
              </h3>
              <p class="text-brand-text/75 font-light text-base leading-relaxed">
                {feature.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       7. TESTIMONIALS (Editorial Style)
  ═══════════════════════════════════════════════ -->
  <section
    class="py-24 sm:py-32 px-4 sm:px-6 bg-brand-primary text-white overflow-hidden relative"
  >
    <div
      class="absolute inset-0 opacity-10 pointer-events-none"
      style="background-image: radial-gradient(circle, #E8A020 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <div class="max-w-6xl mx-auto relative z-10 text-center mb-16">
      <span class="eyebrow text-brand-accent mb-4 block">Client Praise</span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold">
        Voices of Elegance
      </h2>
    </div>

    <div
      class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 relative z-10"
    >
      <!-- Testimonial 1 -->
      <div class="relative pl-8 border-l border-brand-accent/30 flex flex-col justify-between">
        <div>
          <span
            class="text-5xl text-brand-accent/40 font-display leading-none block mb-2"
            >&ldquo;</span
          >
          <p
            class="font-display text-lg lg:text-xl font-light italic leading-relaxed mb-6"
          >
            Grace Interior Designs created a stunning floral wall art in our living room. Everyone who visits is spellbound — it has truly become the soul of our home.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10">
          <h4
            class="font-bold text-brand-accent tracking-wide uppercase text-sm"
          >
            Ravindranath
          </h4>
          <span class="text-white/50 text-xs tracking-widest uppercase block mt-0.5"
            >Hanumakonda &bull; Floral Arts</span
          >
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="relative pl-8 border-l border-brand-accent/30 flex flex-col justify-between">
        <div>
          <span
            class="text-5xl text-brand-accent/40 font-display leading-none block mb-2"
            >&ldquo;</span
          >
          <p
            class="font-display text-lg lg:text-xl font-light italic leading-relaxed mb-6"
          >
            The wall mural on our villa exterior is a true masterpiece. Incredible craftsmanship and the weather-proof painting has held up beautifully.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10">
          <h4
            class="font-bold text-brand-accent tracking-wide uppercase text-sm"
          >
            Venu
          </h4>
          <span class="text-white/50 text-xs tracking-widest uppercase block mt-0.5"
            >Warangal &bull; Wall Murals</span
          >
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="relative pl-8 border-l border-brand-accent/30 flex flex-col justify-between">
        <div>
          <span
            class="text-5xl text-brand-accent/40 font-display leading-none block mb-2"
            >&ldquo;</span
          >
          <p
            class="font-display text-lg lg:text-xl font-light italic leading-relaxed mb-6"
          >
            Our school campus walls were transformed into a colorful wonderland. The kids absolutely love the paintings and parents are amazed every single time!
          </p>
        </div>
        <div class="pt-4 border-t border-white/10">
          <h4
            class="font-bold text-brand-accent tracking-wide uppercase text-sm"
          >
            Shashidar
          </h4>
          <span class="text-white/50 text-xs tracking-widest uppercase block mt-0.5"
            >Hyderabad &bull; School &amp; Educational Art</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       8. SERVICE AREAS
  ═══════════════════════════════════════════════ -->
  <section
    class="py-24 sm:py-32 px-4 sm:px-6 bg-brand-bg relative overflow-hidden"
  >
    <div
      class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center"
    >
      <!-- Text/Lists -->
      <div class="lg:col-span-5 space-y-12">
        <div>
          <span class="eyebrow text-brand-accent mb-4 block"
            >Where We Create</span
          >
          <h2
            class="font-display text-4xl sm:text-5xl font-bold text-brand-primary mb-6"
          >
            Serving Luxury Spaces
          </h2>
          <p class="text-brand-text/80 text-lg font-light max-w-md">
            We are proud to bring our handcrafted art to the most prestigious
            addresses across the region.
          </p>
        </div>

        <div class="flex gap-16">
          <!-- Regions -->
          <div>
            <h4
              class="font-bold text-brand-primary uppercase tracking-widest text-xs mb-4"
            >
              Regions
            </h4>
            <ul
              class="space-y-3 font-display text-xl text-brand-text/90 font-medium"
            >
              <li>Hanumakonda</li>
              <li>Warangal</li>
              <li>Hyderabad</li>
            </ul>
          </div>
          <!-- Sectors -->
          <div>
            <h4
              class="font-bold text-brand-primary uppercase tracking-widest text-xs mb-4"
            >
              Sectors
            </h4>
            <ul class="space-y-2 text-brand-text/75 font-light">
              <li>Residential Homes</li>
              <li>Luxury Villas</li>
              <li>Boutique Hotels</li>
              <li>Cafés & Restaurants</li>
              <li>Corporate Offices</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Clean Map / Visual -->
      <div class="lg:col-span-7">
        <div
          class="aspect-[16/10] bg-white border border-brand-divider/40 p-2 overflow-hidden shadow-2xl relative"
        >
          <img
            src="https://images.unsplash.com/photo-1574805726207-6c84c17b5eec?w=1000&q=80"
            alt="Architectural plan"
            class="w-full h-full object-cover opacity-80 mix-blend-luminosity"
            loading="lazy"
          />

          <div class="absolute top-[40%] left-[30%] flex items-center gap-2">
            <div
              class="w-3 h-3 bg-brand-accent rounded-full animate-ping absolute"
            ></div>
            <div class="w-3 h-3 bg-brand-accent rounded-full relative"></div>
            <span
              class="font-display font-bold text-brand-primary bg-white/90 backdrop-blur-sm px-2 py-1 text-xs"
              >Warangal</span
            >
          </div>

          <div class="absolute top-[55%] left-[65%] flex items-center gap-2">
            <div
              class="w-3 h-3 bg-brand-accent rounded-full animate-ping absolute"
            ></div>
            <div class="w-3 h-3 bg-brand-accent rounded-full relative"></div>
            <span
              class="font-display font-bold text-brand-primary bg-white/90 backdrop-blur-sm px-2 py-1 text-xs"
              >Hyderabad</span
            >
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       9. FINAL CALL TO ACTION (Reused exact layout)
  ═══════════════════════════════════════════════ -->
  <section
    class="cta-stage relative py-20 sm:py-28 px-6 text-center overflow-hidden border-t border-brand-accent/30"
  >
    <!-- Subtle background pattern -->
    <div class="max-w-3xl mx-auto relative z-10">
      <span class="eyebrow text-brand-accent mb-4 block"
        >Start Your Project</span
      >
      <h2
        class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-brand-primary leading-tight mb-4"
      >
        Ready to Transform<br />
        <span class="text-brand-accent italic">Your Walls?</span>
      </h2>
      <p
        class="text-brand-text/70 text-base sm:text-xl font-light mb-8 max-w-xl mx-auto"
      >
        Let's create something extraordinary together.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/919701483107?text=Hi+Grace+Interior+Designs%2C+I%27d+like+to+know+more+about+your+services."
          target="_blank"
          rel="noopener noreferrer"
          class="glow-pulse inline-flex items-center gap-3 bg-brand-accent hover:bg-[#d4901a] text-brand-primary font-bold py-4 px-10 text-base shadow-xl hover:scale-105 transition-transform duration-200"
        >
