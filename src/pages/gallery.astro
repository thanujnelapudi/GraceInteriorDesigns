---
// src/pages/gallery.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../utils/categories';

const allWorks = await getCollection('works');

// Map category slugs to display labels for filters
const filterLabels: Record<string, string> = {
  'floral-arts':  'Floral Arts',
  'wall-murals':  'Wall Murals',
  'school-art':   'School Art',
  'wall-art':     'Wall Art',
};

const heroImage = "https://images.unsplash.com/photo-1604014237800-1c9102c219da?w=1920&q=85";
const signatureImage = "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=1920&q=80";
---

<Layout
  title="Portfolio — Grace Interior Designs"
  description="An exhibition of handcrafted wall murals, floral arts, school and educational art, and bespoke wall paintings crafted for spaces across Hanumakonda, Warangal, and Hyderabad."
>

  <!-- ═══════════════════════════════════════════════
       HERO — Cinematic exhibition opening
  ═══════════════════════════════════════════════ -->
  <section class="relative h-[85vh] min-h-[560px] flex flex-col justify-end overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt="Luxury interior wall art portfolio"
        class="ken-burns w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-gradient absolute inset-0"></div>
    </div>

    <!-- Hero content — bottom anchored -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 pb-16 sm:pb-24 w-full">
      <span class="eyebrow text-brand-accent mb-4 block reveal-up">Grace Interior Designs</span>
      <h1 class="font-display text-white leading-none reveal-up" style="transition-delay:0.1s">
        <span class="block text-5xl sm:text-7xl lg:text-8xl font-bold">Crafted Spaces.</span>
        <span class="block text-5xl sm:text-7xl lg:text-8xl font-bold italic text-brand-accent">Painted Stories.</span>
      </h1>
      <p class="mt-6 text-white/70 text-base sm:text-xl font-light max-w-2xl reveal-up" style="transition-delay:0.2s">
        A curated collection of handcrafted murals, floral arts, school wall paintings, and bespoke interior artworks transforming spaces across Hanumakonda, Warangal, and Hyderabad.
      </p>
      <!-- Scroll indicator -->
      <div class="mt-10 flex flex-col items-start gap-2 text-white/50 reveal-up" style="transition-delay:0.3s">
        <span class="eyebrow text-[10px]">Scroll to explore</span>
        <div class="w-px h-10 bg-gradient-to-b from-white/50 to-transparent animate-pulse"></div>
      </div>
    </div>
  </section>



  <!-- ═══════════════════════════════════════════════
       MASONRY PORTFOLIO GRID
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-4 sm:px-6 bg-brand-bg" id="portfolio-grid">
    <div class="max-w-7xl mx-auto">
      <!-- Count label -->
      <div class="flex items-center justify-between mb-10 reveal-up">
        <p class="text-brand-text/50 text-sm">
          <span id="visibleCount">{allWorks.length}</span> works in collection
        </p>
        <div class="w-12 h-px bg-brand-accent"></div>
      </div>

      <!-- CSS Columns masonry — native editorial rhythm -->
      <div id="masonryGrid" class="columns-1 sm:columns-2 lg:columns-3 gap-6">
        {allWorks.map((w, i) => {
          const isTall = i % 5 === 0;
          return (
            <div
              class="portfolio-card group break-inside-avoid mb-6 relative overflow-hidden rounded-sm shadow-sm hover:shadow-md transition-shadow duration-300"
              data-category={w.data.category}
            >
              <!-- Image Container -->
              <div class={`relative overflow-hidden ${isTall ? 'aspect-[3/4]' : i % 3 === 1 ? 'aspect-[4/3]' : 'aspect-square'}`}>
                <img
                  src={w.data.images[0]}
                  alt={w.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.02]"
                />
                <!-- Hover overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-brand-primary/90 via-brand-primary/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>



                <!-- Showcase details — slide up on hover -->
                <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-400 ease-out">
                  <h3 class="font-display text-white text-lg sm:text-xl font-semibold leading-snug mb-1">
                    {w.data.title}
                  </h3>
                  {w.data.suitableSpace && (
                    <p class="text-brand-accent/90 text-xs eyebrow mb-2">{w.data.suitableSpace}</p>
                  )}
                  <p class="text-white/75 text-sm leading-relaxed line-clamp-3">{w.data.description}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="emptyState" class="hidden text-center py-20">
        <p class="font-display text-2xl text-brand-primary/40 italic">No works in this category yet.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SIGNATURE MOMENT
  ═══════════════════════════════════════════════ -->
  <section class="signature-stage relative flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={signatureImage}
        alt="Signature mural"
        class="w-full h-full object-cover"
        loading="lazy"
      />
        <div class="hero-gradient absolute inset-0"></div>
    </div>
    <div class="signature-copy relative z-10 text-left px-6 max-w-5xl mx-auto">
      <div class="reveal-up">
        <p class="signature-text text-white leading-none">Every Wall</p>
        <p class="signature-text text-white leading-none">Deserves</p>
          <p class="signature-text leading-none italic text-brand-accent">A Story.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CONSULTATION CTA
  ═══════════════════════════════════════════════ -->
  <section class="cta-stage relative py-20 sm:py-28 px-6 text-center overflow-hidden border-t border-brand-accent/30">
    <div class="max-w-3xl mx-auto">
      <span class="eyebrow text-brand-accent mb-4 block reveal-up">Start Your Project</span>
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-white leading-tight mb-4 reveal-up" style="transition-delay:0.1s">
        Ready to Transform<br />
        <span class="italic font-normal text-brand-accent">Your Walls?</span>
      </h2>
      <p class="text-white/70 text-base sm:text-xl font-light mb-8 max-w-xl mx-auto reveal-up" style="transition-delay:0.2s">
        Let's design something unique together — tailored to your space, your story, your vision.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal-up" style="transition-delay:0.3s">
        <a
          href="https://wa.me/919701483107?text=Hi+Grace+Interior+Designs%2C+I%27d+like+to+book+a+consultation."
          target="_blank"
          rel="noopener noreferrer"
          class="glow-pulse inline-flex items-center gap-3 bg-brand-accent hover:bg-[#d4901a] text-brand-primary font-bold py-4 px-10 text-base shadow-xl hover:scale-105 transition-transform duration-200"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.487 1.334 5.006l-1.416 5.176 5.297-1.389c1.472.802 3.136 1.226 4.773 1.227h.004c5.505 0 9.988-4.478 9.989-9.985 0-2.668-1.037-5.176-2.925-7.065-1.888-1.888-4.397-2.927-7.066-2.927zm5.228 14.108c-.216.606-1.258 1.164-1.74 1.214-.482.05-1.107.234-3.649-.787-2.73-1.096-4.492-3.868-4.629-4.051-.137-.183-1.107-1.472-1.107-2.806 0-1.334.698-1.99.948-2.256.25-.266.549-.333.732-.333.183 0 .366.002.524.01.166.008.391-.063.612.467.225.541.766 1.87.833 2.008.067.138.113.3.023.482-.09.183-.135.298-.266.457-.132.158-.278.354-.397.476-.132.135-.27.283-.116.549.154.266.686 1.134 1.472 1.834 1.011.901 1.864 1.181 2.13 1.314.266.133.424.116.582-.066.158-.183.674-.787.857-1.054.183-.266.366-.222.616-.133.25.09 1.581.745 1.854.882.274.137.457.208.524.324.067.116.067.674-.149 1.28z"/>
          </svg>
          Book a Consultation
        </a>
        <a
          href="tel:+919701483107"
          class="inline-block border border-brand-primary/40 text-brand-primary hover:border-brand-accent hover:text-brand-accent px-8 py-4 text-base font-semibold tracking-wide transition-all duration-300"
        >
          Call +91 9701483107
        </a>
        <a
          href="/contact"
          class="inline-block border border-brand-primary/40 text-brand-primary hover:border-brand-accent hover:text-brand-accent px-10 py-4 text-base font-semibold tracking-wide transition-all duration-300"
        >
          Send an Enquiry
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SCRIPTS — Filter chips + reveal
  ═══════════════════════════════════════════════ -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // ── Reveal on scroll ──
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal-up, .img-reveal').forEach(el => observer.observe(el));
    });
  </script>

</Layout>
